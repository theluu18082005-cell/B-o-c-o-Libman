<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
    <display-name>LibMan</display-name>
    <servlet>
        <servlet-name>libman</servlet-name>
        <servlet-class>vn.ptit.libman.web.LibManServlet0</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>libman</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/reader</url-pattern>
        <url-pattern>/reader/card</url-pattern>
        <url-pattern>/manager</url-pattern>
        <url-pattern>/manager/reports</url-pattern>
        <url-pattern>/manager/statistics</url-pattern>
        <url-pattern>/manager/history</url-pattern>
        <url-pattern>/manager/loan</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config><http-only>true</http-only></cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list><welcome-file>login</welcome-file></welcome-file-list>
</web-app>
